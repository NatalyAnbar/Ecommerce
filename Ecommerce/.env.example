SECRET_KEY='change-me'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (used by docker-compose to create the database)
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me

# How Django connects to that database
DATABASE_URL=postgres://ecommerce:change-me@127.0.0.1:5432/ecommerce

# Set to True in production only (needs HTTPS)
SECURE_SSL_REDIRECT=False

# Comma-separated full origins with https://, needed in production only
CSRF_TRUSTED_ORIGINS=

# Email: printed in the terminal by default; use SMTP in production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@ecommerce.local

# The frontend page that reads uid and token from the link and calls the confirm endpoint
PASSWORD_RESET_URL=http://localhost:3000/reset-password

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com