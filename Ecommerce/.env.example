SECRET_KEY='change-me'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (used by docker-compose to create the database)
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me

# How Django connects to that database
DATABASE_URL=postgres://ecommerce:change-me@127.0.0.1:5432/ecommerce

# Set to True in production only (needs HTTPS)
SECURE_SSL_REDIRECT=False

# Comma-separated full origins with https://, needed in production only
CSRF_TRUSTED_ORIGINS=